/target
/refs

# Packaged artifacts: `dist/plugin.wasm` ships with the repo (plugin.toml points
# at it), but the zip and the build stamp are recreated by script/package.ps1 on
# every run, so tracking them would leave the tree permanently dirty.
dist/*.zip
dist/*.sources

# Signed install packages are distributed through GitHub releases; the registry
# pins their SHA-256, so a committed copy would only go stale.
*.oiplugin

# Publisher signing key from `openidea-plugin keygen`. A leaked key hands the
# whole `apimocktle.*` namespace to whoever has it, so it must never be staged.
*.key

# Trellis working data stays local: specs, tasks, workspace journals, scripts
# and the workflow scaffolding are per-machine state, not shipped with the
# plugin. `trellis update` keeps maintaining them on disk.
/.trellis/

# Trellis-generated agent skills and DSH instructions: regenerated locally by
# `trellis update`, none of it is plugin source. AGENTS.md stays tracked — it is
# the generic pointer every agent reads, not generated skill content.
/.agents/
/.dsh/
